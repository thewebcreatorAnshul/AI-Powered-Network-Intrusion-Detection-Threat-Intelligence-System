MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=intrusion_detection
THREAT_INTEL_MODE=offline
# Set THREAT_INTEL_MODE=local and provide an authorized local indicator JSON file to enable enrichment.
THREAT_INTEL_FILE=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_PASSWORD_RESET=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
RETENTION_HOURS=24

# Local demonstration defaults only. Provision authenticated, TLS-protected MongoDB for deployment.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=intrusion_detection
THREAT_INTEL_MODE=offline
# Set THREAT_INTEL_MODE=local and provide an authorized local indicator JSON file to enable enrichment.
THREAT_INTEL_FILE=
JWT_SECRET=REPLACE_ME
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_RESET=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
MAX_ANALYSIS_PACKETS=50000
ANALYSIS_TIMEOUT_SECONDS=120
MAX_FOREGROUND_ANALYSES=2
RETENTION_HOURS=24
SHUTDOWN_GRACE_SECONDS=15
MONGODB_SOCKET_TIMEOUT_MS=5000
